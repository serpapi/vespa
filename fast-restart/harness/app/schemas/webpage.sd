# Generated by rounds/r6/make_schema.sh from the deployed webpage.sd (a71c7a4ea8). Do not edit by hand.
schema webpage {
    document webpage {

        # --- URL / identity ---

        field url type string { indexing: summary }

        # Reversed domain for site: prefix matching. "en.wikipedia.org" → "org.wikipedia.en."
        field rdomain type string {
            indexing: attribute
            attribute: fast-search
            match: prefix
            rank: filter
        }
        # URL path for site:/path prefix filtering. paged: memory-mapped, not
        # RAM-resident (~30 GB/node freed). site: narrows by rdomain (fast-search)
        # first, so the path prefix only scans one domain's docs.
        field path type string {
            indexing: attribute
            attribute: paged
            match: prefix
            rank: filter
        }
        # URL shape for learned ranking (searchindex.urls.url_shape / UrlFieldDocProc):
        # characters in the URL and non-empty path segments (0 = homepage). Attribute-only,
        # set at creation; unset (legacy) docs read as NaN in rank expressions.
        field url_len type int {
            indexing: attribute
        }
        field path_depth type byte {
            indexing: attribute
        }

        # --- Content ---

        field title type string {
            indexing: index | summary
            stemming: none
        }
        field body type string {
            indexing: index | summary
            stemming: best
            index: enable-bm25
        }
        field snippet type string {
            indexing: index | summary
            stemming: none
        }
        field image_url type string { indexing: summary }
        field sitelinks type array<string> { indexing: summary }

        # --- Crawl metadata ---

        # No longer written (2026-10-01): nothing read it, and as a paged string attribute every
        # write paid a B-tree dictionary lookup that faulted ~4K pages of its mmap'd enum store —
        # 17 % of a content node's major page faults (content-1, perf, 30 s). Kept in the schema so
        # old documents and deployed feeders stay valid; drop it with the next reindex.
        field content_hash type string {
            indexing: summary | attribute
            attribute: paged
        }
        # 0=distilled  1=crawled/live  2=cc  3=discovered
        field status_code type byte {
            indexing: attribute
        }
        # FineWeb text quality heuristic (0.0–1.0). Written by crawlers/CC at ingest time.
        field quality_score type float {
            indexing: attribute
        }
        # Pre-computed authority scalar used as the match-phase sort attribute.
        #   distilled docs:  max(original_authority, original_count)  (distillation.py)
        #   CC / crawled:    max(1, round(quality_score * 10))         (commoncrawl.py, crawler.py)
        # StaticRankDocProc fills this for any PUT that arrives without it set.
        field static_rank type int {
            indexing: attribute
            attribute: fast-search
        }
        field last_updated type long {
            indexing: attribute
        }

        # --- SERP-distilled signals (written only by distillation.py, never by crawlers) ---

        # Per-term position weights across all SERPs this URL appeared in.
        # fast-search: required for WAND retrieval in SearchIndexSearcher.
        # Growth is bounded per doc by ORIGINAL_SIGNAL_UPDATE_CAP (distillation.py): every
        # `add` rebuilds the doc's whole set on one proton field-writer lane.
        field original_queries type weightedset<string> {
            indexing: attribute | summary
            attribute: fast-search
        }
        # Full-query → position weight. rawScore(original_query_positions) is the primary
        # distilled ranking signal. Capped at 10 in capped_oqp() to prevent KG/answer_box
        # position blocks (weight 12-15) from outranking the navigational target.
        # fast-search: required for WAND retrieval in SearchIndexSearcher.
        field original_query_positions type weightedset<string> {
            indexing: attribute | summary
            attribute: fast-search
        }
        # Indexed array of all queries where this doc appeared; BM25 on this field
        # drives query_affinity(). Written as creation-only — existing docs do not gain
        # later entries (re-enabling online appends would restore doc-store write amplification).
        field original_query_lexicon type array<string> {
            indexing: index | summary
            stemming: none
        }
        # Number of SERP observations distillation has applied to this URL (0 for CC/crawl-only
        # docs). Not a ranking input: safe_original_count() is exported for debugging only.
        # Gates Op2 in distillation.py — once it reaches ORIGINAL_SIGNAL_UPDATE_CAP the
        # original_* weighted sets stop growing, bounding the O(entries) field-writer cost
        # of each update. Backfill replays over-count by their replay multiplicity.
        field original_count type int {
            indexing: attribute
        }
        # Accumulated block-importance + feature bonuses across SERPs. Feeds into static_rank.
        # Read only via attribute() in ranking and at ingest; never matched, so no fast-search.
        field original_authority type int {
            indexing: attribute
        }
        # Exclusion signal for safe=active (the default): docs with ≥1 are dropped from every
        # query path. Two writers: (a) distillation assigns 1 when the URL appeared in a SERP
        # whose request carried an explicit safe=off. Most SERPs carry no safe= at all,
        # so this alone leaves unsafe pages unmarked.
        # fast-search + rank:filter: zero-scan bitvector filter on every query path.
        field original_safe_miss_count type int {
            indexing: attribute
            attribute: fast-search
            rank: filter
        }
        # Independent safe-search domain-policy label. Kept separate from SERP provenance
        # so rollback can clear the policy label without exposing a safe=off result.
        field policy_domain_miss type int {
            indexing: attribute
            attribute: fast-search
            rank: filter
        }
        # Distillation assigns 1 for every SERP appearance whose request was *not* safe=off —
        # including the majority with no safe parameter — so this is "not-known-unsafe", not
        # "seen under SafeSearch". SafeCountDocProc recomputes it on PUT/reindex, setting it
        # to zero for policy-labeled docs and otherwise using max(0, original_count - misses).
        # Not a safety signal; do not build filtering on it.
        field original_safe_count type int {
            indexing: attribute
        }

        # --- Host-level enrichment (backfilled offline) ---

        # Eigenvector centrality on the SERP co-occurrence link graph (0–100, log scale).
        # Not true PageRank: edges are symmetric co-occurrence, not directed endorsement.
        # Treated as a 0.1× tiebreaker in authority_score(), not a primary signal.
        field host_pagerank type int {
            indexing: attribute
        }
        # Median FineWeb quality across crawled pages on this host (0.0–1.0).
        # NaN when the host has fewer than 3 sampled docs (compute_host_quality.py --min-docs).
        # host_quality_boost() falls back to the page's own quality_score when NaN.
        field host_quality type float {
            indexing: summary | attribute
        }
        # Tranco top-1M domain rank. CC ingest quality filter only — not used in ranking.
        field tranco_rank type int {
            indexing: attribute
        }
        # BM25-enabled pseudo-body: SERP snippets accumulated across all queries.
        # weightedset keys are indexed as text terms; weights are unused.
        field snippets_history type weightedset<string> {
            indexing: index
            stemming: none
            index: enable-bm25
        }
        # Document language. Set from hl= at distillation time; overwritten by crawlers via <html lang>.
        # fast-search enables bitvector promotion so every YQL language filter is zero-scan cost.
        field language type string {
            indexing: attribute | summary
            attribute: fast-search
            rank: filter
        }
        # Display-formatted publication date (e.g. "May 14, 2026"). Summary-only.
        field publication_date type string {
            indexing: summary
        }

        # --- Geo / language signals (distillation only) ---

        # Per-term language weights deposited at distillation time (e.g. {"pain": 1} for hl=fr).
        field original_term_hl type weightedset<string> {
            indexing: attribute
        }
        # Per-term country weights deposited at distillation time (e.g. {"lotus": 1} for gl=gb).
        field original_term_gl type weightedset<string> {
            indexing: attribute
        }

        # --- R6: fast-access single-value numerics for the partial-update fast path ---
        field price type float {
            indexing: attribute
            attribute: fast-access
        }
        field status type int {
            indexing: attribute
            attribute: fast-access
        }
        field boost type float {
            indexing: attribute
            attribute: fast-access
        }
    }

    # --- Document summaries ---

    # YQL / legacy path. from-disk fetches text fields from the docstore.
    document-summary default {
        from-disk
        summary url { source: url }
        summary title { source: title }
        summary snippet { source: snippet }
        summary image_url { source: image_url }
        summary sitelinks { source: sitelinks }
        summary publication_date { source: publication_date }
    }

    # Native Vespa query path (SearchIndexSearcher.java). No from-disk: language is
    # served from the attribute store (attribute | summary) to avoid a from-disk conflict.
    document-summary serpapi {
        summary url { source: url }
        summary title { source: title }
        summary snippet { source: snippet }
        summary image_url { source: image_url }
        summary sitelinks { source: sitelinks }
        summary publication_date { source: publication_date }
        summary language { source: language }
    }

    # Extends serpapi with original_queries for spell-check in ResultProcessingSearcher.
    document-summary spelling inherits serpapi {
        summary original_queries { source: original_queries }
    }

    # search_index.snippet_choice=history: the Google snippets of every SERP the page appeared in,
    # so ResultProcessingSearcher can serve the one closest to this query. Read from the docstore.
    document-summary serpapi_snippets inherits serpapi {
        summary snippets_history { source: snippets_history }
    }
    document-summary spelling_snippets inherits spelling {
        summary snippets_history { source: snippets_history }
    }

    # Learned-ranking data collection (search_index.raw=on). Adds the stored SERP
    # weightedsets and the attributes the offline feature pipeline derives from.
    document-summary ltr inherits spelling {
        summary original_query_positions { source: original_query_positions }
        summary rdomain { source: rdomain }
        summary path { source: path }
        summary status_code { source: status_code }
        summary last_updated { source: last_updated }
        summary original_count { source: original_count }
    }

    fieldset default { fields: title, snippet, snippets_history, original_query_lexicon }

    # Memory-free text for the content path (search_index.legs=content, content_* profiles).
    # snippets_history (Google snippets accumulated per past query) and original_query_lexicon
    # are SERP memory (searchindex/ltr.MEMORY_RE); body has its own leg (different stemming).
    fieldset content { fields: title, snippet }

    # ==========================================================================
    # Rank profiles
    # ==========================================================================
    #
    #   default   Normal queries. match-phase max-hits=10000, rerank-count=200.
    #   recall    Stopword-heavy / cold queries (auto-selected by SearchIndexSearcher
    #             based on stopword ratio). max-hits=100000, rerank-count=600.
    #   ltr_v1    Production default (query profile): learned second phase, no match-phase
    #             limiter. ltr_v1_limited = the same with recall's limiter (A/B arm).
    #   bm25      Alias of default; useful for A/B via search_index.ranking param.
    #   no_serp   Ablation of default with distilled-SERP signals zeroed.
    #   serp_v2   Proposed new default: stronger exact full-query SERP replay and
    #             capped term-level SERP boost, selected only via search_index.ranking.
    #   debug     Adds match-features + summary-features for per-signal inspection.
    #             Usage: python main.py query "…" --ranking debug [--target prod]
    # ==========================================================================

    rank-profile default inherits default {
        inputs {
            query(temporal_boost_factor) double: 1.0   # 3.0 for temporal queries
            query(ymyl_boost_factor)     double: 1.0   # 2.0 for YMYL queries
            query(site_authority_factor) double: 1.0   # 0.3 for site: queries
            query(num_terms)             double: 1.0   # set by SearchIndexSearcher per query
            query(geo_active)            double: 0.0   # 1.0 when hl or gl is explicit; gates geo_affinity()
            query(geo_terms_hl)          tensor(k{})   # {"chat:fr": 9, ...} set by SearchIndexSearcher for explicit hl
            query(geo_terms_gl)          tensor(k{})   # {"chat:fr": 9, ...} set by SearchIndexSearcher for explicit gl
        }

        rank-properties {
            bm25(title).k1: 0.9
            bm25(title).b: 0.3
            bm25(snippet).k1: 1.2
            bm25(snippet).b: 0.5
            bm25(snippets_history).k1: 1.2
            bm25(snippets_history).b: 0.5
            bm25(original_query_lexicon).k1: 1.2
            bm25(original_query_lexicon).b: 0.25
            bm25(body).k1: 1.2
            bm25(body).b: 0.75
        }

        # NaN-safe attribute accessors. Vespa int attributes read as INT_MIN when unset;
        # float/long attributes read as NaN. Guard all before log10 / exp / comparisons.
        function safe_static_rank()        { expression: if(isNan(attribute(static_rank)), 0, attribute(static_rank)) }
        function safe_original_authority() { expression: if(isNan(attribute(original_authority)), 0, attribute(original_authority)) }
        function safe_original_count()     { expression: if(isNan(attribute(original_count)), 0, attribute(original_count)) }
        function safe_host_pagerank()      { expression: if(isNan(attribute(host_pagerank)), 0, attribute(host_pagerank)) }
        # Authority. static_rank is the primary scalar; host_pagerank is a 0.1× tiebreaker.
        # authority_without_pagerank_raw and *_active kept for debug/rollback inspection.
        function authority_without_pagerank_raw() { expression: safe_static_rank() }
        function host_pagerank_raw()              { expression: 0.1 * safe_host_pagerank() }
        function authority_raw()                  { expression: max(host_pagerank_raw(), authority_without_pagerank_raw()) }
        function host_pagerank_active()           { expression: if(host_pagerank_raw() > safe_static_rank(), 1.0, 0.0) }
        function static_rank_active()             { expression: if(safe_static_rank() >= host_pagerank_raw(), 1.0, 0.0) }

        # Text relevance.
        function bm25_score()     { expression: bm25(title) * 3.0 + bm25(snippet) * 2.0 + bm25(snippets_history) * 1.5 + bm25(body) * 1.0 }
        function query_affinity() { expression: bm25(original_query_lexicon) }
        # "term:hl"/"term:gl" affinity as a rank-expression dot product over the document's weightedsets,
        # evaluated only for matched documents and only when hl/gl is explicit. Not a query-tree dotProduct:
        # original_term_hl/gl have no fast-search, so proton has no posting lists for them and turns such
        # an item into a full docid scan on every node (prod 2026-09-11: 1.7 s / coverage 20% vs 0.2 s).
        function hl_affinity()    { expression: sum(tensorFromWeightedSet(attribute(original_term_hl), k) * query(geo_terms_hl)) }
        function gl_affinity()    { expression: sum(tensorFromWeightedSet(attribute(original_term_gl), k) * query(geo_terms_gl)) }
        function geo_affinity()   { expression: if(query(geo_active) > 0, max(0, hl_affinity()) + max(0, gl_affinity()), 0) }

        # Quality. quality_score may be 0–1 (current) or 0–100 (legacy); both are normalized.
        function normalized_quality_score() {
            expression {
                if(isNan(attribute(quality_score)), 0,
                   if(attribute(quality_score) > 1.0, attribute(quality_score) / 100.0,
                      attribute(quality_score)))
            }
        }
        function quality_boost() { expression: normalized_quality_score() * 5.0 }
        # Falls back to the page's own quality_score when host_quality is NaN (< 3 sampled docs).
        # Falling back to 0 would penalize new/sparsely-crawled domains vs well-sampled ones.
        function host_quality_boost() {
            expression {
                if(isNan(attribute(host_quality)),
                   normalized_quality_score() * 3.0 * query(ymyl_boost_factor),
                   attribute(host_quality) * 3.0 * query(ymyl_boost_factor))
            }
        }

        # Document age in days (-1 when unknown); a learned-ranking input.
        function age_days()       { expression: if(isNan(attribute(last_updated)), -1.0, (now() - attribute(last_updated)) / 86400.0) }
        # Freshness. exp() decay is second-phase only (too costly for 100K first-phase candidates).
        function freshness()      { expression: if(isNan(attribute(last_updated)), 0.0, 0.5 * exp(-1 * (now() - attribute(last_updated)) / (90 * 86400))) }
        function fast_freshness() { expression: max(0.0, 0.5 * (1.0 - (now() - attribute(last_updated)) / (90 * 86400))) }
        # Extra 24-hour boost for status_code=1 (live-crawled) pages.
        function temporal_boost() { expression: if(isNan(attribute(status_code)), 0, if(attribute(status_code) == 1, 15.0 * exp(-1 * (now() - attribute(last_updated)) / 86400), 0)) }

        # Authority scores. fast_ variant (first-phase) uses static_rank only for speed.
        # Full variant (second-phase) adds host_pagerank at 0.1× as a tiebreaker, capped at 40.
        function fast_authority_score() { expression: min(20.0 * log10(1 + max(0, safe_static_rank())), 40.0) }
        function authority_score()      { expression: min(20.0 * log10(1 + max(0, authority_raw())), 40.0) }
        function ymyl_authority()       { expression: authority_score() * query(ymyl_boost_factor) }

        # Distilled signal. rawScore(original_query_positions) is a dotProduct of the query
        # against stored full-query position weights. Capped at 10 to prevent KG/answer_box
        # position blocks (weight 12-15) from outranking the navigational target.
        function raw_distilled_position_score() { expression: rawScore(original_query_positions) }
        function capped_oqp()                   { expression: if(raw_distilled_position_score() > 10, 10, raw_distilled_position_score()) }
        function original_rank()                { expression: capped_oqp() * 5.0 }
        function term_rank()                    { expression: log10(1 + max(0, rawScore(original_queries))) * 2.0 + log10(1 + max(0, raw_distilled_position_score())) * 2.0 }
        function has_distilled_signal()         { expression: if(raw_distilled_position_score() > 0, 1.0, 0.0) }

        # Coverage gate: fraction of query terms backed by full-query position signal.
        # Per-term best weight is 10, so divide by (query(num_terms) * 10).
        function distilled_coverage_ratio() { expression: min(1.0, raw_distilled_position_score() / max(1.0, query(num_terms) * 10.0)) }
        # Legacy alias kept for existing debug tooling.
        function get_ranked_results()       { expression: distilled_coverage_ratio() }
        # Cubed so partial coverage (e.g. one of three terms) leans strongly toward the novel tier.
        function distilled_blend_weight()   { expression: pow(distilled_coverage_ratio(), 3) * has_distilled_signal() }
        # Legacy alias kept for existing debug tooling.
        function d()                        { expression: distilled_blend_weight() }

        # Authority at 10% weight when the doc has no matching text or position signal.
        function text_relevance_gate()  { expression: if(bm25(title) + bm25(snippet) + raw_distilled_position_score() > 0.01, 1.0, 0.1) }

        # Distilled tier: position signal dominates, authority is tiebreaker.
        function distilled_first()  { expression: original_rank() * 20.0 + fast_authority_score() + geo_affinity() * 10.0 }
        function distilled_second() { expression: original_rank() * 20.0 + authority_score() + freshness() + geo_affinity() * 10.0 }

        # Novel tier: best-effort without distilled position knowledge.
        function novel_first()      { expression: term_rank() + bm25(title) * 3.0 + fast_authority_score() * text_relevance_gate() * query(site_authority_factor) + fast_freshness() + geo_affinity() * 3.0 + quality_boost() * 0.3 }
        function novel_second()     { expression: bm25_score() + term_rank() + query_affinity() + ymyl_authority() * text_relevance_gate() * query(site_authority_factor) + freshness() * query(temporal_boost_factor) + temporal_boost() * query(temporal_boost_factor) + geo_affinity() * 3.0 + quality_boost() + host_quality_boost() }
        function blended_first_phase_score()  { expression: distilled_blend_weight() * distilled_first() + (1 - distilled_blend_weight()) * novel_first() }
        function blended_second_phase_score() { expression: distilled_blend_weight() * distilled_second() + (1 - distilled_blend_weight()) * novel_second() }

        first-phase {
            expression: blended_first_phase_score()
        }

        num-threads-per-search: 2

        match-phase {
            max-hits: 10000
            attribute: static_rank
            order: descending
        }

        diversity {
            attribute: rdomain
            min-groups: 5
        }

        second-phase {
            expression: blended_second_phase_score()
            rerank-count: 200
        }
    }

    # R6: the deployed default profile, with the updated attributes read in both phases.
    rank-profile r6 inherits default {
        first-phase {
            expression: blended_first_phase_score() + attribute(boost)
        }
        second-phase {
            expression: blended_second_phase_score() + attribute(boost) * 2.0
            rerank-count: 200
        }
    }
}
