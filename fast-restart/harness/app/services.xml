<?xml version="1.0" encoding="utf-8" ?>
<!-- Fast-restart measurements (fast-restart/PREREG.md). Copied from rounds/r6/app of search-api-bench, which
     copies the deployed content tuning (a71c7a4ea8). Added: the production proton overrides from
     ext/search-index/deploy/group_vars/all.yml (index.maxflushed 8, lid-space compaction paused). -->
<services version="1.0">
    <admin version="2.0">
        <adminserver hostalias="node1"/>
        <configservers><configserver hostalias="node1"/></configservers>
    </admin>
    <container id="default" version="1.0">
        <search/>
        <document-api/>
        <document-processing/>
        <http><server id="default" port="8080"/></http>
        <nodes><node hostalias="node1"/></nodes>
    </container>
    <content id="content" version="1.0">
        <redundancy>1</redundancy>
        <documents>
            <document type="webpage" mode="index"/>
            <document-processing cluster="default"/>
        </documents>
        <nodes><node hostalias="node1" distribution-key="0"/></nodes>
        <search>
            <visibility-delay>30.0</visibility-delay>
        </search>
        <engine>
            <proton>
                <flush-on-shutdown>true</flush-on-shutdown>
                <tuning>
                    <searchnode>
                        <requestthreads><persearch>2</persearch></requestthreads>
                        <flushstrategy>
                            <native>
                                <total><diskbloatfactor>0.5</diskbloatfactor></total>
                                <component><diskbloatfactor>0.5</diskbloatfactor></component>
                            </native>
                        </flushstrategy>
                        <summary>
                            <io><read>directio</read></io>
                            <store>
                                <cache>
                                    <maxsize-percent>10</maxsize-percent>
                                    <compression><type>none</type></compression>
                                </cache>
                            </store>
                        </summary>
                    </searchnode>
                </tuning>
            </proton>
        </engine>
        <config name="vespa.config.search.core.proton">
            <index><maxflushed>8</maxflushed></index>
            <lidspacecompaction>
                <removeblockrate>0.01</removeblockrate>
                <allowedlidbloat>1000</allowedlidbloat>
                <allowedlidbloatfactor>0.6</allowedlidbloatfactor>
            </lidspacecompaction>
        </config>
        <tuning>
            <resource-limits>
                <memory>0.90</memory>
                <disk>0.92</disk>
            </resource-limits>
        </tuning>
    </content>
</services>
